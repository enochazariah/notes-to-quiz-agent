# Copy this file to .env and fill in your own values. .env is git-ignored; this example is safe to commit.
# ======================================================================
# Safe to commit: placeholders only. Your real values go in .env, which IS git-ignored.
# Never paste a real key into this file or into a chat; never print it in logs.
# On Render, do NOT upload this file. Add the same names in the
# Render dashboard (Environment tab) instead.
# While the token still starts with PASTE_ the app runs in offline DEMO MODE.
# ======================================================================

# 1. Your Amazon Bedrock API key (AWS console > Bedrock > API keys).
#    Give it an expiry date when you create it.
AWS_BEARER_TOKEN_BEDROCK=PASTE_YOUR_BEDROCK_API_KEY_HERE

# 2. The AWS region where you created the key and where the model is available.
AWS_REGION=us-east-1

# 3. The model to use. Run:  python scripts/check_bedrock.py  to see what your account can use.
#    Newer models need an inference-profile ID with a region prefix (us. / eu. / apac. / global.).
#    Pick a Claude or Amazon Nova model: they support the structured output this app needs.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Optional
# ACCESS_CODE=choose-a-short-code-for-your-supervisor
# DEMO_MODE=1
# MAX_PDF_MB=25
# BEDROCK_MAX_TOKENS=4096
